# OpcTagManager Web
APP_HOST=0.0.0.0
APP_PORT=1863
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Bangkok

# OPC browsing
OPC_URL=opc.tcp://kepware.example.local:49320
OPC_SUBSCRIPTION_BATCH_SIZE=100
OPC_FAST_SYNC_ATTEMPTS=10
OPC_FAST_SYNC_RETRY_DELAY_SEC=0.5
# Legacy single-line label. In scoped mode this resolves from LINE_NAME instead.
PRODUCTION_LINE=LEGACY_SITE_LABEL
# Optional multi-line identity; configure channel patterns at the same time.
# LINE_NAME=SB11
# KEPWARE_CHANNEL_PATTERNS=SB11,SB11_*,SB11S7
# LINE_ID is a deprecated fallback input; do not use it in new profiles.

# SQL Server
SQL_DRIVER=AUTO
SQL_SERVER=sql-server.example.local
SQL_DB=database_name
SQL_USER=database_user
SQL_PASS=change-me
SQL_TRUST_SERVER_CERTIFICATE=true
# Blank preserves driver-default encryption behavior; set yes/no only when deployment requires it.
SQL_ENCRYPT=

# Alarm configuration. MP3_FOLDER is OpcTagManager's server-side browse/preview root;
# it may differ physically from alarm_sound's playback root, but filenames must match.
ALARM_WRITE_ENABLED=false
MP3_FOLDER=\\audio-host.example.local\Alarm
ALARM_RELOAD_ENABLED=false
RELOAD_ALARM_NODE=
RELOAD_ALARM_CHANNEL=SYSTEM
RELOAD_ALARM_DEVICE=OpcTagManager
RELOAD_ALARM_GROUP_PATH=
RELOAD_ALARM_DRIVER=Memory Based
RELOAD_ALARM_DEVICE_MODEL=0
RELOAD_ALARM_DEVICE_ID_FORMAT=1
RELOAD_ALARM_DEVICE_ID=1
RELOAD_ALARM_ADDRESS=D0000
RELOAD_ALARM_DATA_TYPE=6
RELOAD_ALARM_READ_WRITE_ACCESS=1
RELOAD_ALARM_SCAN_RATE_MS=1000
RELOAD_ALARM_BOOTSTRAP_ENABLED=false
RELOAD_ALARM_REPAIR_ENABLED=false
RELOAD_ALARM_SELF_HEAL_ENABLED=false
RELOAD_ALARM_HISTORIAN_ENABLED=false
PRODUCTION_ALARM_OWNER=legacy_alarm_system
OPCTAGMANAGER_ALARM_CAPABILITY=development_ready

# Kepware Configuration API (reserved for a future phase)
KEPWARE_CONFIG_API_SCHEME=https
KEPWARE_CONFIG_API_HOST=kepware.example.local
KEPWARE_CONFIG_API_PORT=57412
KEPWARE_CONFIG_API_USER=api_user
KEPWARE_CONFIG_API_PASSWORD=change-me
KEPWARE_CONFIG_API_VERIFY_SSL=true
KEPWARE_CONFIG_API_TIMEOUT=10
KEPWARE_CONFIG_CACHE_TTL_SEC=30
KEPWARE_CONFIG_WRITE_ENABLED=false
KEPWARE_TAG_DEFAULT_DATA_TYPE=5
KEPWARE_TAG_DEFAULT_SCAN_RATE_MS=100
KEPWARE_TAG_DEFAULT_ACCESS=1

# KM Tag Knowledge storage
KM_TAG_ROOT=D:\path\to\KM\Vault\Tags
KM_TAG_WRITE_ENABLED=false
KM_RESOURCE_WRITE_ENABLED=false
KM_RESOURCE_MAX_UPLOAD_MB=100

# InfluxDB
INFLUX_HOST=influxdb.example.local
INFLUX_PORT=8086
INFLUX_DB=database_name
INFLUX_USER=influx_user
INFLUX_PASS=change-me

# Poller
POLL_INTERVAL=5
OPC_RUNTIME_SUPERVISOR_ENABLED=false
OPC_RUNTIME_RECONCILE_ON_STARTUP=true
# Conservative full browse interval for newly added Kepware tags; 0 disables periodic reconcile.
OPC_RUNTIME_RECONCILE_INTERVAL_SEC=900
LEGACY_POLLER_LAUNCHER=D:\path\to\opc_service\poller.bat
# Safe legacy default. Set opc_tag_manager only after an explicit ownership decision;
# this setting describes intended ownership and never starts a writer by itself.
PRODUCTION_HISTORIAN_OWNER=legacy_opc_service

# Kepware Modbus
KEPWARE_MODBUS_HOST=kepware.example.local
KEPWARE_MODBUS_PORT=502
RELOAD_BROWSER_ADDR=12001
RELOAD_POLLER_ADDR=12002
RELOAD_TEST_ADDR=12004
RELOAD_EAK_ADDR=12005
# OT inventory: scan only explicitly configured ranges, one /24 per profile.
# Preferred Phase 1 format (uncomment to enable; do not leave this variable blank):
# OT_SCAN_RANGES=MAIN_OT|192.168.0.1|192.168.0.254;REJECT_OT|192.254.59.1|192.254.59.254
# Legacy fallback is used only when OT_SCAN_RANGES is absent. One private /24.
# Example: OT_SCAN_START=172.28.231.1 and OT_SCAN_END=172.28.231.254
OT_SCAN_START=
OT_SCAN_END=
# Legacy MA-L local IEEE CSV or JSON: {"00:11:22": "Vendor name"}; no internet lookup.
OT_OUI_FILE=
# Optional offline IEEE files. MA-L override takes precedence over OT_OUI_FILE.
OT_OUI_MAL_FILE=
OT_OUI_MAM_FILE=
OT_OUI_MAS_FILE=
# Optional Windows ping reverse-name resolution using the host's configured resolver.
OT_RESOLVE_HOSTNAMES=false
