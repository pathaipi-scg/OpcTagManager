# OpcTagManager Web
APP_HOST=0.0.0.0
APP_PORT=1863
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Bangkok

# OPC browsing
OPC_URL=opc.tcp://kepware.example.local:49320
BROWSER_SCRIPT=D:\path\to\browser.py
PRODUCTION_LINE=LINE_NAME

# SQL Server
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=sql-server.example.local
SQL_DB=database_name
SQL_USER=database_user
SQL_PASS=change-me
SQL_TRUST_SERVER_CERTIFICATE=true

# Kepware Configuration API (reserved for a future phase)
KEPWARE_CONFIG_API_SCHEME=https
KEPWARE_CONFIG_API_HOST=kepware.example.local
KEPWARE_CONFIG_API_PORT=57412
KEPWARE_CONFIG_API_USER=api_user
KEPWARE_CONFIG_API_PASSWORD=change-me
KEPWARE_CONFIG_API_VERIFY_SSL=true
KEPWARE_CONFIG_API_TIMEOUT=10
KEPWARE_CONFIG_CACHE_TTL_SEC=30
KEPWARE_CONFIG_WRITE_ENABLED=false
KEPWARE_TAG_DEFAULT_DATA_TYPE=5
KEPWARE_TAG_DEFAULT_SCAN_RATE_MS=100
KEPWARE_TAG_DEFAULT_ACCESS=1

# KM Tag Knowledge storage
KM_TAG_ROOT=D:\path\to\KM\Vault\Tags
KM_TAG_WRITE_ENABLED=false
KM_RESOURCE_WRITE_ENABLED=false

# InfluxDB
INFLUX_HOST=influxdb.example.local
INFLUX_PORT=8086
INFLUX_DB=database_name
INFLUX_USER=influx_user
INFLUX_PASS=change-me

# Poller
POLL_INTERVAL=5

# Kepware Modbus
KEPWARE_MODBUS_HOST=kepware.example.local
KEPWARE_MODBUS_PORT=502
RELOAD_BROWSER_ADDR=12001
RELOAD_POLLER_ADDR=12002
RELOAD_TEST_ADDR=12004
RELOAD_EAK_ADDR=12005
